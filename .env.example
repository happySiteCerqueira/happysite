# Copie este arquivo para ".env" (na raiz do projeto, ao lado do docker-compose.yml) e defina
# uma senha forte antes de rodar "docker compose up -d" no VPS.
DB_PASSWORD=troque-por-uma-senha-forte-e-unica

# Opcional: envia automaticamente cada backup diário para a pasta "SISTEMA CERQUEIRA" no Google
# Drive (https://drive.google.com/drive/folders/1PnftnPAiqXAazYcTfKjAG5-y59Pu6ioO), via API oficial
# usando uma conta de serviço do Google Cloud. Veja o passo a passo completo em
# DEPLOY_VPS.md (seção "Backup automático no Google Drive"). Cole aqui o conteúdo INTEIRO do
# arquivo .json baixado no Google Cloud Console, em uma única linha.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...", ...}
