# Copie este arquivo para ".env" (na raiz do projeto, ao lado do docker-compose.yml) e defina
# uma senha forte antes de rodar "docker compose up -d" no VPS.
DB_PASSWORD=troque-por-uma-senha-forte-e-unica

# OBRIGATORIO: segredo que assina os tokens de login (minimo 32 caracteres, aleatorio, unico).
# Gere com:  openssl rand -base64 48   e NUNCA o coloque no repositorio. Trocar este valor
# derruba todas as sessoes abertas (todos precisam entrar de novo).
JWT_SECRET=gere-com-openssl-rand-base64-48

# Opcional: senha do usuario "admin" criado quando o banco esta vazio. Se nao definir, uma senha
# aleatoria e gerada e exibida uma unica vez no log do container (docker compose logs app).
# ADMIN_INITIAL_PASSWORD=defina-uma-senha-forte

# Opcional: envia automaticamente cada backup diário para a pasta "SISTEMA CERQUEIRA" no Google
# Drive (https://drive.google.com/drive/folders/1PnftnPAiqXAazYcTfKjAG5-y59Pu6ioO), via API oficial
# usando uma conta de serviço do Google Cloud. Veja o passo a passo completo em
# DEPLOY_VPS.md (seção "Backup automático no Google Drive"). Cole aqui o conteúdo INTEIRO do
# arquivo .json baixado no Google Cloud Console, em uma única linha.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...", ...}

# Notificações push (lembretes da Agenda e avisos de ASO/Experiência). Sem estas chaves o
# recurso fica simplesmente desligado — o resto do sistema funciona normalmente.
# Gere o par de chaves UMA única vez rodando no servidor:
#   docker compose exec app npx web-push generate-vapid-keys
# Veja o passo a passo em DEPLOY_VPS.md (seção "Notificações push").
# VAPID_PUBLIC_KEY=cole-aqui-a-chave-publica
# VAPID_PRIVATE_KEY=cole-aqui-a-chave-privada
# VAPID_SUBJECT=mailto:contato@cerqueiraengenharia.com.br

# Controle Financeiro Familiar (separado das permissões da construtora).
# Apenas estes e-mails podem acessar /familia. Separe vários com vírgula.
# nessalohn@gmail.com e jorlansantos.fmu@gmail.com já vêm liberados por padrão no código; esta
# variável serve para ACRESCENTAR outros e-mails (sem precisar deles aqui).
# O e-mail é cadastrado na tela Usuários; se o usuário antigo não tiver e-mail, vale o login.
# FAMILIA_ALLOWED_EMAILS=meuemail@gmail.com,esposa@gmail.com

# Opcional: cotações B3 via brapi.dev (sem chave, apenas os limites do plano gratuito).
# BRAPI_TOKEN=
