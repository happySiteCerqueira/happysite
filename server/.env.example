DATABASE_URL=postgresql://usuario:senha@host/database?sslmode=require
PORT=3001
# Segredo dos tokens de login (minimo 32 caracteres). Em desenvolvimento, se ausente, e usado um
# segredo aleatorio temporario; em producao ele e obrigatorio.
# JWT_SECRET=

# E-mails autorizados no módulo familiar (separados por vírgula; cadastre em Usuários).
# nessalohn@gmail.com e jorlansantos.fmu@gmail.com já vêm liberados por padrão no código
# (server/utils/requireFamiliaAuth.js); esta variável serve para ACRESCENTAR outros e-mails.
# FAMILIA_ALLOWED_EMAILS=meuemail@gmail.com,esposa@gmail.com
# BRAPI_TOKEN=
